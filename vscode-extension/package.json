{
  "name": "stellarclassic-pulse-explorer",
  "displayName": "StellarClassic Pulse Explorer",
  "description": "Browse, test, and inspect StellarClassic Pulse API endpoints directly from VS Code.",
  "version": "0.1.0",
  "publisher": "stellarclassic-pulse",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "keywords": ["soroban", "stellar", "blockchain", "api", "rest"],
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/stellarclassic-pulse/stellarclassic-pulse"
  },
  "activationEvents": [
    "onView:stellarclassicpulse.apiExplorer"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "stellarclassicpulse",
          "title": "StellarClassic Pulse",
          "icon": "media/pulse.svg"
        }
      ]
    },
    "views": {
      "stellarclassicpulse": [
        {
          "id": "stellarclassicpulse.apiExplorer",
          "name": "API Explorer",
          "icon": "media/pulse.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "stellarclassicpulse.openRequestTester",
        "title": "Open in Request Tester",
        "icon": "$(play)"
      },
      {
        "command": "stellarclassicpulse.refreshExplorer",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "stellarclassicpulse.copyUrl",
        "title": "Copy URL",
        "icon": "$(copy)"
      },
      {
        "command": "stellarclassicpulse.openSettings",
        "title": "StellarClassic Pulse: Open Settings"
      },
      {
        "command": "stellarclassicpulse.setApiKey",
        "title": "StellarClassic Pulse: Set API Key"
      },
      {
        "command": "stellarclassicpulse.setAdminApiKey",
        "title": "StellarClassic Pulse: Set Admin API Key"
      },
      {
        "command": "stellarclassicpulse.clearApiKeys",
        "title": "StellarClassic Pulse: Clear Stored API Keys"
      },
      {
        "command": "stellarclassicpulse.testWebhook",
        "title": "StellarClassic Pulse: Test Webhook",
        "icon": "$(radio-tower)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "stellarclassicpulse.refreshExplorer",
          "when": "view == stellarclassicpulse.apiExplorer",
          "group": "navigation"
        },
        {
          "command": "stellarclassicpulse.testWebhook",
          "when": "view == stellarclassicpulse.apiExplorer",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "stellarclassicpulse.openRequestTester",
          "when": "view == stellarclassicpulse.apiExplorer && viewItem == endpoint",
          "group": "inline"
        },
        {
          "command": "stellarclassicpulse.copyUrl",
          "when": "view == stellarclassicpulse.apiExplorer && viewItem == endpoint"
        }
      ]
    },
    "configuration": {
      "title": "StellarClassic Pulse",
      "properties": {
        "stellarclassicpulse.baseUrl": {
          "type": "string",
          "default": "http://localhost:3000",
          "description": "Base URL of the StellarClassic Pulse API server."
        },
        "stellarclassicpulse.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key sent as the x-api-key header. Prefer 'StellarClassic Pulse: Set API Key' instead, which stores it in SecretStorage rather than this plaintext setting; this is kept only as a fallback for existing configs."
        },
        "stellarclassicpulse.adminApiKey": {
          "type": "string",
          "default": "",
          "description": "Admin API key for /admin/* endpoints."
        },
        "stellarclassicpulse.timeoutMs": {
          "type": "number",
          "default": 10000,
          "description": "Request timeout in milliseconds."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vscode/vsce": "^2.22.0",
    "eslint": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
